# Copy to .env and fill in real values. .env is gitignored.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2000

# --- Databricks SQL warehouse (required) ---
# Host name only; a full https:// URL is accepted and trimmed.
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=dapi_your_personal_access_token
DATABRICKS_CATALOG=your_catalog_name
DATABRICKS_SCHEMA=your_schema_name

# --- Application ---
DEBUG=False
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=30
MAX_QUERY_LENGTH=1000
MAX_ROWS_DISPLAY=100
ENABLE_QUERY_OPTIMIZATION=True

# Where local accounts are stored. Keep this outside the repository.
USER_STORE_PATH=.data/users.json

# --- AWS (deployment only; credentials come from the AWS credential chain) ---
AWS_REGION=us-east-1
