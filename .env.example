# Copy to .env and fill in real values. .env is gitignored.

# --- Hugging Face inference (required) ---
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Inference provider routed through the Hugging Face Inference API.
HF_PROVIDER=nebius

# Any chat-completion model the provider serves.
HF_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B

# --- Optional tuning ---
HF_MAX_TOKENS=500
HF_TEMPERATURE=0.0
HF_TIMEOUT=60

# Row cap applied when the generated query has no LIMIT of its own.
MAX_RESULT_ROWS=5000

# Example rows shown to the model alongside the schema.
PROMPT_SAMPLE_ROWS=3
